APP_NAME=PromptCraft Hub
APP_VERSION=1.0.0
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/promptcraft.db
LOG_LEVEL=INFO
ENABLE_PROMPT_CONTENT_LOGGING=false
LOCAL_ADMIN_MODE=true
AUTO_OPEN_BROWSER=true
SESSION_EXPIRY_MINUTES=60
MAX_IMPORT_FILE_MB=5
BACKUP_DIRECTORY=./backups
SECRET_KEY=
